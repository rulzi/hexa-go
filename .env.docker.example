# Docker environment configuration
# Copy to .env.docker (gitignored) before running docker-compose:
#   cp .env.docker.example .env.docker
#
# Generate secure values:
#   openssl rand -base64 32

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DEBUG=false

# MySQL container (MYSQL_* vars are read by the official mysql image)
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=hexa_go
MYSQL_USER=hexa_user
MYSQL_PASSWORD=change-me-db-password

# Application database configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=hexa_user
DB_PASSWORD=change-me-db-password
DB_NAME=hexa_go

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration (minimum 32 characters in production)
JWT_SECRET=change-me-use-openssl-rand-base64-32
JWT_EXPIRATION=24

# Storage Configuration
STORAGE_BASE_PATH=/app/storage
STORAGE_BASE_URL=http://localhost:8080
